# ==============================================================================
# SHAIK MANSOOR PERSONAL FITNESS PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. SUPABASE DATABASE & AUTHENTICATION
# Obtain these from your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 2. SUPABASE SERVICE ROLE (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 3. PUBLIC SITE URL
NEXT_PUBLIC_SITE_URL=https://mansoorfitness.com

# 4. ADMIN CMS CREDENTIALS & AUTHENTICATION
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here
AUTH_SECRET=your_32_character_random_secret_here

# 5. ENVIRONMENT MODE
NODE_ENV=development
