{
  "name": "mannu-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build:css": "npx tailwindcss@3.4.17 --content \"./src/**/*.{js,ts,jsx,tsx,mdx}\" -o ./src/app/tailwind.css",
    "build": "npm run build:css && node node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types tests/runner.mjs",
    "test:visual": "node tests/visual-qa.mjs",
    "postinstall": "node patch-node24.cjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^3.0.7"
  }
}
